
int f(int ind , int w , vector<int> &profit, vector<int> &weight , vector<vector<int>>& dp)
{
    //base case 
    if (ind == 0)
    {
        return (w/weight[0])*profit[0];
    }

    //memoization
    if(dp[ind][w] != -1) return dp[ind][w];

    //apply all the condition 
    int nt = 0 + f(ind-1,w,profit,weight,dp);
    int t = 0;
    if (weight[ind] <= w)
    {
        t = profit[ind] + f(ind , w-weight[ind] , profit , weight,dp);
    }

    //return 
    return dp[ind][w] = max(t,nt);
}


int unboundedKnapsack(int n, int w, vector<int> &profit, vector<int> &weight){
    // Write Your Code Here.
    vector<vector<int>> dp(n,vector<int>(w+1,-1));
    return f(n-1,w,profit,weight,dp);
}
