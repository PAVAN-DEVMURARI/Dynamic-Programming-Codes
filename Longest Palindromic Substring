    string longestPalindrome(string s) {
        
        if (s.length() <= 1) return s;
        int n = s.length();
        if (n==2 && s[0] == s[1]) return s; 

        string lps = "";

        for (int i=0;i<n;i++){
            //consider the odd length
            int low = i;
            int high = i;

            //keep extending in both left and right
            while (low >= 0 && high < n && s[low] == s[high]){
                low--;
                high++;
            }

            string pal = s.substr(low+1,high-low-1);

            if (pal.length() > lps.length()){
                lps = pal;
            }

            //consider ever length
            low = i;
            high = i+1;
            while (low >= 0 && high < n && s[low] == s[high]){
                low--;
                high++;
            }

            pal = s.substr(low+1,high-low-1);

            if (pal.length() > lps.length()){
                lps = pal;
            }

        }

        return lps;


    }
};
