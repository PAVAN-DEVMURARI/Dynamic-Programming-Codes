class Solution {
public:

    int cnt_set_bits(int n)
    {
        int cnt = 0;
        while(n)
        {
            cnt+=(n&1);
            n = n >> 1;
        }
        return cnt;
    }

    vector<int> countBits(int n) {
        vector<int> ans(n+1);
        for(int i=0;i<=n;i++)
        {
            ans[i] = cnt_set_bits(i);
        }
        return ans;
    }
};
