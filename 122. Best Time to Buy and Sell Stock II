class Solution {
public:

    int f(int ind , int trading , vector<int>& prices,vector<vector<int>>& dp)
    {
        //base case 
        int n = prices.size();
        if (ind == n) return 0;;
        
        //memoization 
        if (dp[ind][trading] != -1) return dp[ind][trading];
        //explore
        //buy 
        int profit = 0;
        if (trading) 
        {
            profit = max((-prices[ind] + f(ind+1,0,prices,dp)) , (f(ind+1,1,prices,dp)));
        }
        else
        {
            profit = max(prices[ind] + f(ind+1,1,prices,dp) , 0 + f(ind+1,0,prices,dp));
        }

        return dp[ind][trading] = profit;
    }

    int maxProfit(vector<int>& prices) {

        int n = prices.size();

        vector<vector<int>> dp(n,vector<int>(2,-1));
        return f(0 , 1 , prices,dp);
    }
};
