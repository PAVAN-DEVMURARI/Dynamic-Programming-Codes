class Solution {
public:

    int f(int ind, vector<int>& cost,vector<int>& dp)
    {
        //base case
        if(ind == 0 || ind == 1) return 0;

        if(dp[ind] != -1) return dp[ind];

        int two_steps = cost[ind-2]+f(ind-2,cost,dp);
        int one_step = cost[ind-1]+f(ind-1,cost,dp);

        return dp[ind] = min(two_steps , one_step);
    }

    int minCostClimbingStairs(vector<int>& cost) {
        int n = cost.size();
        // int mini = INT_MAX;
        vector<int> dp(n+1,-1);
        return f(n,cost,dp);
        
    }
};
