#include <bits/stdc++.h> 

int mod = (int)(1e9+7);

int f(int ind , int sum, vector<int>& nums , vector<vector<int>>& dp)
{
    if (ind == 0) {
        if (sum == 0 && nums[0] == 0) return 2;   // pick & not pick
        if (sum == 0 || sum == nums[0]) return 1;
        return 0;
    }

    //memoization
    if (dp[ind][sum] != -1)return dp[ind][sum];

    //not take
    int nt = f(ind-1,sum,nums,dp);
    //take
    int t = 0;
    if (nums[ind] <= sum)
    {
        t = f(ind-1,sum-nums[ind],nums,dp);
    }

    //return 
    return dp[ind][sum] = (t+nt)%mod;
}

int countPartitions(int n, int d, vector<int> &arr) {
    // Write your code here.
    int sum = 0;
    for (int i=0;i<n;i++)
    {
        sum+=arr[i];
    }
    int x = (sum-d)/2;
    if ((sum-d)%2!=0 || (sum-d)<0)return 0;
    vector<vector<int>> dp(n,vector<int>(x+1,-1));
    return f(n-1,x,arr,dp);


}


