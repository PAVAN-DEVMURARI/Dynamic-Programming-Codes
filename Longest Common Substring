int lcs(string &str1, string &str2){
    // Write your code here.
    int a = str1.length();
    int b = str2.length();

    vector<vector<int>> dp(a+1,vector<int>(b+1,0));
    
    int ans = 0;
    for (int i=1;i<=a;i++)
    {
        for (int j = 1;j<=b ;j++)
        {
            if (str1[i-1] == str2[j-1]) dp[i][j] = 1 + dp[i-1][j-1];
            ans = max(ans,dp[i][j]);
        }
    }

    return ans ;

}
